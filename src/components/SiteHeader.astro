---
/* The compact plate used on inner pages, with a text nav. */
import { site, nav } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '');
---
<header class="plate">
  <div class="bar">
    <p class="side tag bl">{site.tagline}</p>
    <a href="/" class="seal" aria-label={`${site.name}, home`}>
      <img src="/images/seal.png" alt="" width="72" height="72" />
    </a>
    <p class="side est bl">{site.established}</p>
  </div>
  <nav class="nav" aria-label="Main">
    {nav.map((item) => {
      const here = current === item.href;
      return (
        <a href={item.href} class:list={['bl', { here }]} aria-current={here ? 'page' : undefined}>
          {item.label}
        </a>
      );
    })}
  </nav>
</header>

<style>
  .plate {
    padding: 28px clamp(20px, 4.4vw, 64px) 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; }
  .tag { margin: 0; font-size: 18px; line-height: 1.35; max-width: 280px; }
  .est { margin: 0; font-size: 20px; text-align: right; }
  .seal { width: 100px; height: 100px; }

  .nav { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 44px; }
  .nav a { position: relative; color: var(--on-field); text-decoration: none; font-size: 23px; padding: 6px 0; }
  .nav a::after {
    content: "";
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: 0;
    height: 1px;
    background: rgba(242, 255, 247, .7);
    opacity: 0;
    transition: opacity .8s ease;
  }
  .nav a:hover::after, .nav a:focus-visible::after, .nav a.here::after { opacity: 1; }
  .nav a:focus-visible { outline: 2px solid var(--focus-on-field); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .nav a::after { transition: none; }
  }

  @container (max-width: 640px) {
    .bar { grid-template-columns: 1fr; justify-items: center; gap: 8px; }
    .side { display: none; }
    .nav { gap: 4px 22px; }
    .nav a { font-size: 20px; }
  }
</style>
