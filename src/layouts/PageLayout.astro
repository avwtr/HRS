---
/* Inner pages: compact plate, a single 640px reading column, footer. */
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  /** Vertical space between sections. */
  gap?: number;
}

const { title, description, gap = 72 } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main class="page">
    <div class="sections" style={`gap: ${gap}px`}>
      <slot />
    </div>
    <footer class="page-foot">
      <SiteFooter />
    </footer>
  </main>
</BaseLayout>

<style>
  .page { max-width: 780px; margin: 0 auto; box-sizing: border-box; padding: clamp(44px, 7vw, 96px) 20px 40px; }
  .sections { display: flex; flex-direction: column; }
  .page-foot { margin-top: 88px; padding-top: 18px; border-top: 1px solid var(--rule-strong); }
  :global(.intro) .page { animation: hrs-fade 1.6s ease .1s both; }

  /* Shared prose styles for inner pages */
  .page :global(p) { margin: 0; }
  .page :global(.stack) { display: flex; flex-direction: column; gap: 20px; }
  .page :global(.h1) { margin: 0; font-size: 52px; line-height: 1.1; color: var(--ink); }
  .page :global(.h2) { margin: 0; font-size: 30px; line-height: 1.2; color: var(--ink); }
  .page :global(.lede) { font-size: 24px; line-height: 1.6; }
  .page :global(.body) { font-size: 20px; line-height: 1.7; }
  .page :global(.sub) { font-style: italic; font-size: 18px; color: var(--ink-soft); }

  @container (max-width: 640px) {
    .page :global(.h1) { font-size: 40px; }
    .page :global(.h2) { font-size: 26px; }
    .page :global(.lede) { font-size: 21px; }
    .page :global(.body) { font-size: 18px; }
  }
</style>
